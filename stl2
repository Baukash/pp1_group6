#include <iostream>
#include <stack>
#include <queue>
#include <deque>
#include <vector>
using namespace std;

int main() {
    stack<int> s; // FILO First in Last Out
    s.push(3);
    s.push(5);
    s.push(7);
    cout<<s.top()<<endl;
    
    while(!s.empty()){
        cout<<s.top()<<" ";
        s.pop();
    }
    
    queue<int> q; //FIFO First in First Out
    q.push(2);
    q.push(5);
    q.push(7);
    cout<<endl<<q.front()<<endl;
    
    while(!q.empty()){
      cout<<q.front()<<" ";
      q.pop();
    }
    
    
    deque<int> dq;
    dq.push_back(5);
    dq.push_front(7);
    dq.push_back(2);
    cout<<endl;
    for(int i: dq){
      cout<<i<<" ";
    }
    
    
}
