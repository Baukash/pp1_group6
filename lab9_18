#include <iostream>
#include <stack>
#include <queue>
#include <deque>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin>>n;
    
    queue<string> q;
    
    
    for(int i=0; i<n; i++){
      int x;
      cin>>x;
      
      if(x==1){
        string s;
        cin>>s;
        q.push(s);
        cout<<q.front()<<endl;
      }
      else if(x==2){
        if(q.empty()) cout<<"queue is empty"<<endl;
        else{
          q.pop();
          if(q.empty()) cout<<"queue is empty"<<endl;
          else cout<<q.front()<<endl;
        }
      }
    }
}

